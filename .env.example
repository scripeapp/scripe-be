# Server
PORT=4000
NODE_ENV=development

# Database (runtime role: scripe_app)
DATABASE_URL=postgres://scripe_app@localhost:5432/scripe_dev
# Database (migration/seed role: scripe_migrator — never used at runtime)
DATABASE_MIGRATE_URL=postgres://scripe_migrator@localhost:5432/scripe_dev
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Destructive and local/CI only. Set true explicitly when running db:reset.
ALLOW_DATABASE_RESET=false

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
AUTH_COOKIE_DOMAIN=localhost
AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend origin used to build user-facing links (e.g. invitation emails).
FRONTEND_URL=http://localhost:3000

# Email (Plunk). Required in production; ignored in development/test.
PLUNK_API_KEY=
PLUNK_FROM_EMAIL=

# Object storage (Cloudflare R2, S3-compatible). Required in production; set
# all four together or leave all four unset. Private bucket — the backend
# issues short-lived presigned upload/download URLs, never a public bucket URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Banking virtual-account issuance provider. Leave unset to keep banking's
# PaymentProviderGateway on its "not configured" stub. Set to "brails" or
# "anchor" to activate that provider — use sandbox keys/base URLs until
# you're deliberately ready to go live with real BVN submissions.
BANKING_PROVIDER=
BRAILS_API_KEY=
BRAILS_BASE_URL=https://sandboxapi.onbrails.com/api/v1
ANCHOR_API_KEY=
ANCHOR_BASE_URL=https://api.sandbox.getanchor.co/api/v1

# Checkout payment gateways for online order payments. Each is independent —
# set the one(s) you want live; the payments domain lets the caller choose
# "paystack" or "flutterwave" per checkout. Use TEST secret keys until you
# are deliberately ready to go live.
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=

# Webhook signature verification for the provider-events domain. Each
# provider uses a different scheme: Paystack re-signs the raw body with
# PAYSTACK_SECRET_KEY; Flutterwave and Anchor/Brails use separate
# dedicated webhook secrets, never the API secret key.
FLW_WEBHOOK_HASH=
ANCHOR_WEBHOOK_TOKEN=
BRAILS_WEBHOOK_SECRET=

# SMS/WhatsApp providers for the communications domain. "dev" (the default
# outside production) accepts every message without calling out; set one of
# the real providers per channel and its credentials to actually send.
SMS_PROVIDER=
WHATSAPP_PROVIDER=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
COMMUNICATIONS_SMS_CREDITS_PER_PART=3
COMMUNICATIONS_WHATSAPP_CREDITS_PER_MESSAGE=2
COMMUNICATIONS_EMAIL_CREDITS_PER_MESSAGE=1
COMMUNICATIONS_MAX_RECIPIENTS_PER_SEND=300

# Shipbubble (delivery domain) - carrier rate/label/tracking provider.
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_WEBHOOK_SECRET=
SHIPBUBBLE_BASE_URL=https://api.shipbubble.com/v1
SHIPBUBBLE_DEFAULT_CATEGORY_ID=20754594
SHIPBUBBLE_DEFAULT_PKG_LENGTH=30
SHIPBUBBLE_DEFAULT_PKG_WIDTH=20
SHIPBUBBLE_DEFAULT_PKG_HEIGHT=10
SHIPBUBBLE_MARKUP_PERCENT=10
