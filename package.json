{
  "name": "@scripe/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "bun src/db/migrate-cli.ts up",
    "db:migrate:down": "bun src/db/migrate-cli.ts down",
    "db:migrate:down:all": "bun src/db/migrate-cli.ts down-all",
    "db:migrate:status": "bun src/db/migrate-cli.ts status",
    "db:reset": "bun src/db/migrate-cli.ts reset",
    "db:seed": "bun src/db/seed.ts",
    "db:types": "bun src/db/generate-types.ts",
    "db:check": "bun src/db/check.ts",
    "db:bootstrap-platform-admin": "bun src/db/bootstrap-platform-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@better-auth/passkey": "1.7.5",
    "better-auth": "1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "kysely": "0.29.6",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "kysely-codegen": "^0.20.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0"
  }
}
