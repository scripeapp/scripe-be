# Server
PORT=4000
NODE_ENV=development

# Database (runtime role: surge_app)
DATABASE_URL=postgres://surge_app@localhost:5432/surge_dev
# Database (migration/seed role: surge_migrator — never used at runtime)
DATABASE_MIGRATE_URL=postgres://surge_migrator@localhost:5432/surge_dev
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Destructive and local/CI only. Set true explicitly when running db:reset.
ALLOW_DATABASE_RESET=false

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
AUTH_COOKIE_DOMAIN=localhost
AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend origin used to build user-facing links (e.g. invitation emails).
FRONTEND_URL=http://localhost:3000

# Email (Plunk). Required in production; ignored in development/test.
PLUNK_API_KEY=
PLUNK_FROM_EMAIL=

# Object storage (Cloudflare R2, S3-compatible). Required in production; set
# all four together or leave all four unset. Private bucket — the backend
# issues short-lived presigned upload/download URLs, never a public bucket URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
